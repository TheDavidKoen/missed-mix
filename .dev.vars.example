# Copy this file to .dev.vars and fill it in. .dev.vars is gitignored and must
# never be committed. The same five values go into the Cloudflare Pages project
# under Settings, Variables and Secrets, for both Production and Preview.

# Atlas connection string. Create a database user scoped to this one database.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Database name inside the cluster.
MONGODB_DB="missed-mix"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me"

# Optional, local only. Node's SRV lookup goes through c-ares rather than the OS
# resolver, and on Windows it sometimes falls back to 127.0.0.1 where nothing is
# listening. Set this to a public resolver if pnpm run init-db fails with querySrv
# ECONNREFUSED. Avoid a router address: it stops answering on any other network.
# DNS_SERVERS="1.1.1.1,8.8.8.8"


SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""