{
  "name": "missed-mix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "pages:build": "pnpm run build && node scripts/bundle-pages.mjs",
    "preview": "pnpm run pages:build && wrangler pages dev build/client --compatibility-date=2026-08-25",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "pnpm run typecheck && pnpm run lint",
    "budget": "node scripts/check-budget.mjs",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "init-db": "node scripts/init-db.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "isbot": "^5.1.36",
    "mongodb": "^7.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/vite-plugin": "^1.54.1",
    "@lhci/cli": "^0.15.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.127.0"
  }
}
